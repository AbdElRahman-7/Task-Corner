PORT=5000
NODE_ENV=production
# Local (non-Docker) default:
MONGO_URI=mongodb://localhost:27017/taskcorner
# Inside Docker Compose use instead:
# MONGO_URI=mongodb://mongodb:27017/taskcorner
# (docker-compose.yml overrides MONGO_URI automatically, so no change is needed for Docker)
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:3000
# Optional invite email
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USER=
# EMAIL_PASS=
